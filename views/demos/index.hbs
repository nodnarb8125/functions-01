{{#> layout title=title}}
  <main class="center stack stack--loose">
    <header class="stack">
      <h1>{{title}}</h1>
      <p class="lead">Interactive pages for layout utilities, components, HTMX, and theming.</p>
    </header>

    <div class="grid">
      <article class="card stack">
        <h2><a href="/demos/components">Components</a></h2>
        <p>Buttons, notices, cards, form controls, and tables.</p>
        <a href="/demos/components" class="button button--primary">Open</a>
      </article>
      <article class="card stack">
        <h2><a href="/demos/layout">Layout</a></h2>
        <p><code>.stack</code>, <code>.cluster</code>, <code>.grid</code>, and <code>.center</code>.</p>
        <a href="/demos/layout" class="button button--primary">Open</a>
      </article>
      <article class="card stack">
        <h2><a href="/demos/htmx">HTMX</a></h2>
        <p>Partial swaps, targets, fragments, and <code>hx-boost</code>.</p>
        <a href="/demos/htmx" class="button button--primary">Open</a>
      </article>
      <article class="card stack">
        <h2><a href="/demos/theme">Theme</a></h2>
        <p>Global light/dark toggle and semantic color tokens.</p>
        <a href="/demos/theme" class="button button--primary">Open</a>
      </article>
    </div>
  </main>
{{/layout}}