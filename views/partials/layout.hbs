<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}}</title>
  <script>
    (function () {
      var t = localStorage.getItem('theme');
      if (t === 'light' || t === 'dark') {
        document.documentElement.setAttribute('data-theme', t);
      }
    })();
  </script>
  <link href="/css/app.css" rel="stylesheet">
</head>
<body>
  <button type="button" class="button theme-toggle" data-theme-toggle aria-label="Toggle color theme">
    <span class="theme-toggle__glyph theme-toggle__glyph--sun" aria-hidden="true">☀</span>
    <span class="theme-toggle__glyph theme-toggle__glyph--moon" aria-hidden="true">☽</span>
  </button>
  {{> @partial-block }}
  <script src="/htmx/htmx.min.js"></script>
  <script src="/js/theme.js"></script>
</body>
</html>
