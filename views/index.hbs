{{#> layout title=title}}
  <main class="center stack stack--loose">
    <h1>{{title}}</h1>
    <p class="lead">Load a fragment from the server with HTMX—no full page reload.</p>
    <div class="cluster">
      <button
        type="button"
        class="button button--primary"
        hx-get="/demo/greeting"
        hx-target="#greeting"
        hx-swap="innerHTML"
      >
        Load greeting
      </button>
    </div>
    <div id="greeting"></div>
  </main>
{{/layout}}
