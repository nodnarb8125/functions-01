{{#> layout title=title}}
  <main class="container py-4">
    <h1 class="display-4">{{title}}</h1>
    <p class="lead">Load a fragment from the server with HTMX—no full page reload.</p>
    <button
      type="button"
      class="btn btn-primary"
      hx-get="/demo/greeting"
      hx-target="#greeting"
      hx-swap="innerHTML"
    >
      Load greeting
    </button>
    <div id="greeting" class="mt-3"></div>
  </main>
{{/layout}}
